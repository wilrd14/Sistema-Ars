<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Inicio de sesión (PRD 11.4): panel Verde Vita 55 % + tarjeta de acceso sobre Niebla. -->
<GridPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="edu.uasd.vitasalud.controller.comun.LoginController">
    <columnConstraints>
        <ColumnConstraints percentWidth="55"/>
        <ColumnConstraints percentWidth="45"/>
    </columnConstraints>
    <rowConstraints>
        <RowConstraints percentHeight="100" vgrow="ALWAYS"/>
    </rowConstraints>

    <VBox styleClass="login-left" alignment="CENTER_LEFT" spacing="20" GridPane.columnIndex="0">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label styleClass="logo-mark" text="V"/>
            <Label styleClass="brand-name-large" text="ARS VitaSalud"/>
        </HBox>
        <Label styleClass="login-headline" text="Autorizaciones y reclamaciones, sin vueltas." wrapText="true"/>
        <Label styleClass="login-lead" wrapText="true"
               text="Un solo portal para prestadores y para el equipo interno de la ARS."/>
    </VBox>

    <StackPane styleClass="login-right" GridPane.columnIndex="1">
        <VBox styleClass="card" alignment="TOP_LEFT" spacing="10" maxWidth="400" prefWidth="400"
              maxHeight="-Infinity">
            <Label styleClass="section-title" text="Bienvenido"/>
            <Label styleClass="texto-secundario" text="Elige tu perfil e inicia sesión."/>

            <HBox styleClass="seg" spacing="4">
                <fx:define>
                    <ToggleGroup fx:id="grupoPerfil"/>
                </fx:define>
                <ToggleButton fx:id="tglPrestador" styleClass="seg-btn" text="Prestador" selected="true"
                              toggleGroup="$grupoPerfil" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <ToggleButton fx:id="tglInterno" styleClass="seg-btn" text="Personal interno"
                              toggleGroup="$grupoPerfil" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>

            <Label fx:id="lblUsuario" styleClass="field-label" text="Usuario del prestador"/>
            <TextField fx:id="txtUsuario" styleClass="field" onAction="#acceder"/>

            <Label styleClass="field-label" text="Contraseña"/>
            <PasswordField fx:id="txtClave" styleClass="field" onAction="#acceder"/>

            <Label fx:id="lblError" styleClass="mensaje-error" wrapText="true"/>

            <Button fx:id="btnAcceder" styleClass="btn" text="Acceder" maxWidth="Infinity" defaultButton="true"
                    onAction="#acceder"/>
            <Hyperlink text="¿Necesitas ayuda para acceder?" onAction="#mostrarAyuda"/>
        </VBox>
    </StackPane>
</GridPane>
