
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.uasd.vitasalud.controller.prestador.ReportesPrestadorController">

    <top>
        <VBox spacing="8.0">
            <padding>
                <Insets top="20.0" right="24.0" bottom="20.0" left="24.0"/>
            </padding>

            <Label text="Reportes del prestador"
                   styleClass="title"/>

            <Label text="Consulta el resumen de la actividad del prestador."
                   styleClass="subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="16.0">
            <padding>
                <Insets top="10.0" right="24.0" bottom="24.0" left="24.0"/>
            </padding>

            <HBox spacing="10.0">
                <Button text="Actualizar reporte"
                        onAction="#actualizarReporte"
                        styleClass="btn"/>
            </HBox>

            <Label text="Resumen de actividad"
                   styleClass="section-title"/>

            <TableView fx:id="tablaReporte"
                       VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="columnaConcepto"
                                 text="Concepto"
                                 prefWidth="250.0"/>

                    <TableColumn fx:id="columnaCantidad"
                                 text="Cantidad"
                                 prefWidth="150.0"/>

                    <TableColumn fx:id="columnaDetalle"
                                 text="Detalle"
                                 prefWidth="350.0"/>
                </columns>
            </TableView>

            <Label fx:id="etiquetaEstado"
                   text="Pulsa Actualizar reporte para consultar los datos."
                   styleClass="subtitle"/>
        </VBox>
    </center>

</BorderPane>
